{
  "name": "tombroucke/bedrock",
  "type": "project",
  "license": "MIT",
  "description": "WordPress boilerplate with Composer, easier configuration, and an improved folder structure",
  "homepage": "https://roots.io/bedrock/",
  "authors": [
    {
      "name": "Scott Walkinshaw",
      "email": "scott.walkinshaw@gmail.com",
      "homepage": "https://github.com/swalkinshaw"
    },
    {
      "name": "Ben Word",
      "email": "ben@benword.com",
      "homepage": "https://github.com/retlehs"
    }
  ],
  "keywords": [
    "bedrock",
    "composer",
    "roots",
    "wordpress",
    "wp",
    "wp-config"
  ],
  "support": {
    "issues": "https://github.com/roots/bedrock/issues",
    "forum": "https://discourse.roots.io/category/bedrock"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://otomaties.private-packages.com",
      "only": [
        "otomaties-plugin/*"
      ]
    },
    {
      "name": "wp-packages",
      "type": "composer",
      "url": "https://repo.wp-packages.org"
    }
  ],
  "require": {
    "php": ">=8.2",
    "blade-ui-kit/blade-icons": "^1.5",
    "composer/installers": "^2.1",
    "log1x/acf-composer": "^3.0",
    "log1x/navi": "^3.0",
    "oscarotero/env": "^2.1",
    "otomaties-plugin/advanced-custom-fields-pro": "^6.0",
    "roots/acorn": "^6",
    "roots/bedrock-autoloader": "^1.0",
    "roots/bedrock-disallow-indexing": "^2.0",
    "roots/wordpress": "^6.9",
    "roots/wp-config": "1.0.0",
    "spatie/ray": "^1.34",
    "tombroucke/acf-objects": "^4.0",
    "tombroucke/otomaties-cookie-consent": "^2.3",
    "tombroucke/otomaties-core": "^2.2",
    "vlucas/phpdotenv": "^5.4",
    "wp-plugin/duracelltomi-google-tag-manager": "^1.16",
    "wp-plugin/html-forms": "^1.3",
    "wp-plugin/imagify": "^2.1",
    "wp-plugin/redirection": "^5.2",
    "wp-plugin/wordfence": "^8.0",
    "wp-plugin/wordpress-seo": "^27.8",
    "wp-plugin/worker": "^4.9",
    "owenvoke/blade-fontawesome": "^3.2"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "tombroucke/otomaties-sage-helper": "dev-master",
    "tombroucke/otomaties-deployer": "^2.0",
    "spatie/laravel-ignition": "^2.4",
    "laravel/pint": "^1.22"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "web/wp",
    "acorn": {
      "aliases": {
        "Post": "App\\Facades\\Post",
        "ThemeJson": "App\\Facades\\ThemeJson"
      }
    }
  },
  "scripts": {
    "post-root-package-install": [
      "php -r \"copy('.env.example', '.env');\""
    ],
    "test": [
      "phpcs"
    ],
    "install-suggests": [
      "composer suggests | xargs -I composer require {}"
    ],
    "post-autoload-dump": [
      "Roots\\Acorn\\ComposerScripts::postAutoloadDump"
    ]
  }
}
